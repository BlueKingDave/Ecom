# Database
DATABASE_URL=postgresql://ecom:ecom_dev_password@localhost:5432/ecom_platform

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Google Cloud Storage
GCS_BUCKET_NAME=ecom-platform-assets

# GCS Authentication (choose one method):
# Method 1: Service Account Key (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Method 2: Default credentials (when running on GCE/Cloud Run)
# Leave GOOGLE_APPLICATION_CREDENTIALS unset, will use default credentials

# Multi-tenant Platform
PLATFORM_DOMAIN=localhost
